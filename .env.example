# ============================================================
# Environment Variables — copy this to .env and fill in values
# ============================================================

# Formspree endpoint for the contact form
# 1. Go to https://formspree.io and create a free form
# 2. Copy your endpoint URL (e.g. https://formspree.io/f/xabcdefg)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/

# Optional: EmailJS (alternative to Formspree)
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=your_public_key
